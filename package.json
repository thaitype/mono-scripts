{
  "name": "@thaitype/mono-scripts",
  "version": "0.1.1",
  "description": "A lightweight toolkit for managing and running shared scripts across multi-package repositories with ease.",
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "test:coverage": "vitest run --coverage",
    "test": "vitest",
    "test:ci": "vitest run",
    "release": "bun run build && release-it",
    "build": "tsup src/index.ts --dts --format esm",
    "format": "prettier -w src",
    "lint": "tsc --noEmit && eslint ./src && prettier -c src",
    "lint:fix": "eslint --fix ./src && prettier -w src"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "release-it": "^17.3.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.27.0",
    "vitest": "^3.0.9"
  },
  "keywords": [],
  "author": "Thada Wangthammang",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaitype/mono-scripts.git"
  },
  "homepage": "https://github.com/thaitype/mono-scripts",
  "dependencies": {
    "execa": "^9.5.2",
    "picocolors": "^1.1.1"
  }
}
